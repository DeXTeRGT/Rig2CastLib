# Bind only to localhost when using a reverse proxy or SSH tunnel.
# Use http://0.0.0.0:8080 only on a trusted LAN or VPN.
URLS=http://127.0.0.1:8080

# Radio-changing operations and PTT remain disabled unless this is true.
Rig2Cast__AllowWrites=false

# Optional locked-station appliance mode. Copy station.example.json to this path,
# edit its radio/audio endpoints, then enable writes above if operator control is intended.
# Rig2Cast__StationConfig=/etc/rig2cast/station.json

# Production reduces framework log noise. Rig2Cast logs still go to the journal.
DOTNET_ENVIRONMENT=Production
